extends: default
ignore: |
  k8s/charts/*/templates/
  .venv/
  .terraform/
rules:
  line-length:
    max: 160
    level: warning
  document-start: disable
  truthy:
    allowed-values: ["true", "false", "yes", "no", "on"]
  comments:
    min-spaces-from-content: 1
  indentation:
    spaces: 2
    indent-sequences: consistent
