# Pinned tool and image versions. Sourced by the Makefile and scripts.
# Change versions here only.

# CLI tools installed into ./.bin by `make tools`
KIND_VERSION=v0.30.0
KIND_NODE_IMAGE=kindest/node:v1.34.0@sha256:7416a61b42b1662ca6ca89f02028ac133a309a2a30ba309614e8ec94d976dc5a
KUBECTL_VERSION=v1.34.1
HELM_VERSION=v3.16.4
TERRAFORM_VERSION=1.9.8
TFLINT_VERSION=v0.54.0
# Trivy: v0.27.0-v0.69.1 releases were deleted (2026-02-28) and v0.69.4 was malicious
# (2026-03-19). 0.69.3 is the last known-good, immutable release. See docs/SECURITY-NOTES.md.
TRIVY_VERSION=0.69.3
SYFT_VERSION=1.18.1
COSIGN_VERSION=v2.4.1
GITLEAKS_VERSION=8.21.2
KYVERNO_CLI_VERSION=v1.19.2
KUBECTL_ARGO_ROLLOUTS_VERSION=v1.10.1
CONFTEST_VERSION=0.56.0
INFRACOST_VERSION=v0.10.39

# Installed inside the Jenkins image only (jenkins/image/Dockerfile)
DOCKER_CLI_VERSION=27.4.1
BUILDX_VERSION=v0.19.3
SONAR_SCANNER_VERSION=6.2.1.4610
AWSCLI_VERSION=2.22.20

# EKS control-plane version: standard support until 2027-03-27 (extended support costs 6x)
EKS_VERSION=1.35

# Helm charts (installed into kind / EKS), re-pinned 2026-11-04 for k8s 1.34/1.35.
# Kyverno 1.19 is the last release with legacy ClusterPolicy; our policies use the
# CEL types (ImageValidatingPolicy / ValidatingPolicy, policies.kyverno.io/v1beta1).
KYVERNO_CHART_VERSION=3.9.2
ARGO_ROLLOUTS_CHART_VERSION=2.43.7
KUBE_PROMETHEUS_STACK_CHART_VERSION=92.10.1
PUSHGATEWAY_CHART_VERSION=3.9.1

# Container images (Compose stack)
# Keep in sync with the literal FROM in jenkins/image/Dockerfile (LTS 2.580.2, 2026-10-28; needs Java 21)
JENKINS_IMAGE=jenkins/jenkins:2.580.2-lts-jdk21
SONARQUBE_IMAGE=sonarqube:10.7.0-community
POSTGRES_IMAGE=postgres:16.6-alpine
REGISTRY_IMAGE=registry:2.8.3
LOCALSTACK_IMAGE=localstack/localstack:3.8.1
LOADGEN_IMAGE=curlimages/curl:8.11.1
# Only used to run promtool / amtool in `make monitoring-test`
PROMETHEUS_IMAGE=prom/prometheus:v3.0.1
ALERTMANAGER_IMAGE=prom/alertmanager:v0.27.0

# App build
PYTHON_BUILD_IMAGE=python:3.11.11-slim-bookworm
PYTHON_RUNTIME_IMAGE=gcr.io/distroless/python3-debian12:nonroot
