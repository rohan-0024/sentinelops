# Pinned tool and image versions. Sourced by the Makefile and scripts.
# Change versions here only.

# CLI tools installed into ./.bin by `make tools`
KIND_VERSION=v0.30.0
KIND_NODE_IMAGE=kindest/node:v1.34.0@sha256:7416a61b42b1662ca6ca89f02028ac133a309a2a30ba309614e8ec94d976dc5a
KUBECTL_VERSION=v1.34.1
HELM_VERSION=v3.16.4
TERRAFORM_VERSION=1.9.8
TFLINT_VERSION=v0.54.0
# Trivy: v0.27.0-v0.69.1 releases were deleted (2026-02-28) and v0.69.4 was malicious
# (2026-03-19). 0.69.3 is the last known-good, immutable release. See docs/SECURITY-NOTES.md.
TRIVY_VERSION=0.69.3
SYFT_VERSION=1.18.1
COSIGN_VERSION=v2.4.1
GITLEAKS_VERSION=8.21.2
KYVERNO_CLI_VERSION=v1.13.2
KUBECTL_ARGO_ROLLOUTS_VERSION=v1.7.2
CONFTEST_VERSION=0.56.0
INFRACOST_VERSION=v0.10.39

# EKS control-plane version: standard support until 2027-03-27 (extended support costs 6x)
EKS_VERSION=1.35

# Helm charts (installed into kind / EKS) - re-checked for k8s 1.34/1.35 in phase 5
KYVERNO_CHART_VERSION=3.3.4
ARGO_ROLLOUTS_CHART_VERSION=2.38.0
KUBE_PROMETHEUS_STACK_CHART_VERSION=66.3.1
PUSHGATEWAY_CHART_VERSION=2.15.0
METRICS_SERVER_CHART_VERSION=3.12.2

# Container images (Compose stack)
