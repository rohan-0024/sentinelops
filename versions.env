SONARQUBE_IMAGE=sonarqube:10.7.0-community
POSTGRES_IMAGE=postgres:16.6-alpine
REGISTRY_IMAGE=registry:2.8.3
LOCALSTACK_IMAGE=localstack/localstack:3.8.1

# App build
PYTHON_BUILD_IMAGE=python:3.11.11-slim-bookworm
PYTHON_RUNTIME_IMAGE=gcr.io/distroless/python3-debian12:nonroot
