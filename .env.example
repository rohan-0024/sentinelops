# Copy to .env and fill in. .env is git-ignored. Every value is optional
# unless marked REQUIRED for a given mode.

# ---- General ----
MODE=local                      # local | aws
OWNER=rohan-0024                # used in resource tags
GIT_REPO_URL=https://github.com/rohan-0024/sentinelops.git

# ---- Jenkins (local) ----
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me          # REQUIRED (local)

# ---- SonarQube ----
SONAR_HOST_URL=http://sonarqube:9000
SONAR_ADMIN_PASSWORD=change-me-Str0ng!    # REQUIRED (local); replaces default admin/admin
SONAR_TOKEN=                              # generated by scripts/sonar-bootstrap.sh

# ---- Notifications (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# ---- AI Failure Explainer (optional) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- FinOps (optional, Phase 7) ----
INFRACOST_API_KEY=

# ---- AWS mode (AWS Academy: copy from Learner Lab "AWS Details") ----
# Prefer ~/.aws/credentials over putting keys here.
AWS_REGION=us-east-1
AWS_PROFILE=default
