# Copy to .env (or run `make init-env`, which also generates strong passwords).
# .env is git-ignored. Comments must stay on their own lines (Docker Compose
# treats text after a value as part of the value).

# ---- General ----
# local | aws
MODE=local
OWNER=rohan-0024
GIT_REPO_URL=https://github.com/rohan-0024/sentinelops.git

# ---- Jenkins ----
JENKINS_ADMIN_USER=admin
# generated by make init-env
JENKINS_ADMIN_PASSWORD=change-me

# ---- SonarQube ----
# generated by make init-env (>= 12 chars, upper/lower/digit/special)
SONAR_ADMIN_PASSWORD=change-me
SONAR_DB_PASSWORD=change-me
# generated by scripts/sonar-bootstrap.sh
SONAR_TOKEN=

# ---- Cosign (image signing) ----
# generated by make init-env / scripts/cosign-keygen.sh
COSIGN_PASSWORD=change-me
COSIGN_KEY_B64=

# ---- Notifications (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# ---- AI Failure Explainer (optional; rule-based fallback without a key) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- FinOps (optional) ----
INFRACOST_API_KEY=

# ---- AWS mode (AWS Academy) ----
# Keep AWS keys in ~/.aws/credentials, never here.
AWS_REGION=us-east-1
# Set after `make aws-apply` (terraform output ecr_repository_url)
ECR_REPOSITORY_URL=
