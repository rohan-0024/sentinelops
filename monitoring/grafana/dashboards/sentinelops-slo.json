    {
      "id": 10,
      "type": "timeseries",
      "title": "Error ratio: canary vs stable",
      "description": "Per Argo Rollouts revision; the canary analysis aborts above 5 %.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
